{
  "manifest_version": 3,
  "name": "seiton",
  "description": "タブとブックマークをワークスペース単位で整理・切り替え。ログイン状態のセッション切替、ブラウザ間同期、使っていないタブの自動クローズにも対応。",
  "version": "1.0.1",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "alarms",
    "favicon",
    "history"
  ],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "seiton (クイックパレット)",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/ui/options.html",
  "incognito": "not_allowed",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+K" },
      "description": "クイックパレット（現在のタブ / ブックマーク / ワークスペース切替）を開く"
    },
    "open-side-panel": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "ワークスペース管理パネルを開く / 閉じる（一時的なウィンドウ）"
    },
    "save-bookmark": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "現在のタブをワークスペースのブックマークフォルダに保存"
    },
    "next-workspace": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "同じセッション内の次のワークスペースへ切り替え"
    },
    "prev-workspace": {
      "description": "同じセッション内の前のワークスペースへ切り替え"
    }
  }
}
