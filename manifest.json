{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "1.0.3",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "alarms",
    "favicon"
  ],
  "optional_permissions": [
    "cookies",
    "history"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/ui/options.html",
  "incognito": "not_allowed",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "__MSG_commandPalette__"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "__MSG_commandManager__"
    },
    "save-bookmark": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_commandSaveBookmark__"
    },
    "next-workspace": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "__MSG_commandNextWorkspace__"
    },
    "prev-workspace": {
      "description": "__MSG_commandPrevWorkspace__"
    }
  }
}
